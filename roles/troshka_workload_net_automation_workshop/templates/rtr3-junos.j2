configure
set system host-name {{ inventory_hostname }}
set interfaces fxp0 unit 0 family inet address {{ ansible_host }}/24
set system services ssh
set system services netconf ssh
set system login user admin uid 2000
set system login user admin class super-user
set system login user admin authentication encrypted-password "{{ router_admin_password_hash }}"
set system root-authentication encrypted-password "{{ router_admin_password_hash }}"
commit
exit

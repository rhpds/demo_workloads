---
profile: production

exclude_paths:
- tests/

skip_list:
- var-naming[no-role-prefix]
- galaxy[no-changelog]
- ignore-errors
- jinja[spacing]

mock_modules:
- agnosticd.core.agnosticd_user_info
- troshka.cloud.project_info
- troshka.cloud.portal_token
- ansible.posix.mount
- ansible.posix.firewalld
- community.general.sefcontext
- community.general.htpasswd
